# Which provider to use: "mock" (default, no key needed) or "openai".
STEPCHECK_PROVIDER=mock

# Model identifier passed to the provider (e.g. gpt-4o for openai).
STEPCHECK_MODEL=gpt-4o

# Required only when STEPCHECK_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Video upload limits; ffmpeg and ffprobe must be installed for local development.
STEPCHECK_MAX_VIDEO_BYTES=52428800
STEPCHECK_MAX_VIDEO_SECONDS=120
STEPCHECK_MAX_VIDEO_FRAMES=48

# Comma-separated CORS origins allowed to call the API.
STEPCHECK_CORS_ORIGINS=["http://localhost:3000"]
